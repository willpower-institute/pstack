# --- pstack settings (prefix PSTACK_) ---
PSTACK_DEBUG=true
PSTACK_SECRET_KEY=change-me-to-a-long-random-string

# DB / Redis (ค่า default ตรงกับ docker-compose)
# ⚠️ ใช้โมดูล tenancy + RLS? อย่าต่อด้วย role นี้ — มันเป็น superuser ของ cluster
#    RLS จะถูก bypass ทั้งหมด · สร้าง role แยกด้วย deploy/db-role.sql แล้วใช้:
#    PSTACK_DATABASE_URL=postgresql+asyncpg://pstack_app:<รหัส>@db:5432/pstack
PSTACK_DATABASE_URL=postgresql+asyncpg://pstack:pstack@db:5432/pstack
PSTACK_REDIS_URL=redis://redis:6379/0

# กันเดารหัสผ่านที่ /api/auth/login (ตั้ง 0 = ปิด) — ใช้ Redis นับถ้าต่อได้
# ต่อ IP นับทุกครั้งใน 1 นาที · ต่อบัญชีนับเฉพาะครั้งที่ล้มเหลวใน 5 นาที
PSTACK_LOGIN_RATE_LIMIT_PER_IP=20
PSTACK_LOGIN_RATE_LIMIT_PER_ACCOUNT=5

# โมดูลที่ให้ระบบติดตั้ง/โหลดตอนบูต (คั่นด้วย comma, kernel จะ resolve dependency ให้เอง)
PSTACK_MODULES=users,storage,ai_agent,line_oa,api_keys,mcp_server

# โมดูล ai_agent — Anthropic SDK อ่าน ANTHROPIC_API_KEY จาก env โดยตรง
ANTHROPIC_API_KEY=
PSTACK_AI_MODEL=claude-opus-5
PSTACK_AI_MAX_TOKENS=16000

# โมดูล storage (module-scoped settings)
PSTACK_STORAGE_DIR=/app/uploads
PSTACK_STORAGE_MAX_SIZE_MB=25

# Admin คนแรก — สร้างอัตโนมัติตอน install โมดูล users (เปลี่ยนรหัสทันทีใน production)
PSTACK_ADMIN_EMAIL=admin@example.com
PSTACK_ADMIN_PASSWORD=admin

# --- ค่าสำหรับ postgres container ---
DB_NAME=pstack
DB_USER=pstack
DB_PASSWORD=pstack
